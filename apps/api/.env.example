# Copy this file to .env (same folder) and adjust values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins: no path, no trailing slash.
CORS_ORIGINS=http://localhost:3000
# Supabase (Project Settings > API Keys). SECRET KEY: server only, never commit.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me_with_real_key
SUPABASE_SECRET_KEY=sb_secret_replace_me_with_real_key
