{
  "name": "collective-commerce",
  "version": "0.0.0",
  "private": true,
  "description": "Collective Commerce: collective purchasing and reverse-bidding marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "env:check": "node -v && npm -v",
    "build:shared": "npm run build -w @cc/shared",
    "build:api": "npm run build -w @cc/api",
    "build:web": "npm run build -w @cc/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev:api": "npm run dev -w @cc/api",
    "dev:web": "npm run dev -w @cc/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
